[Unit]
Description=Forge Scheduled Runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=forge
WorkingDirectory=/work
EnvironmentFile=/etc/forge/env
ExecStart=/usr/bin/python3 /work/runtime/runner.py
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=append:/work/ledger/runner.log
StandardError=append:/work/ledger/runner.log
ProtectSystem=strict
ReadWritePaths=/work
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
