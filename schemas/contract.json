{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "project", "artifacts", "invariants", "dependencies"],
  "additionalProperties": true,
  "properties": {
    "id": {"type": "string"},
    "project": {"type": "string"},
    "artifacts": {"type": "array", "items": {"type": "object", "required": ["path"], "additionalProperties": true, "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "invariants": {"type": "array", "items": {"type": "object", "required": ["kind"], "additionalProperties": true, "properties": {"kind": {"type": "string", "enum": ["exists", "absent", "equals", "matches", "command"]}}}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "frozen": {"type": "boolean"}
  }
}
